  {
    "id": "S16",
    "name": "Content pages don't need a JavaScript app on every page",
    "when": {
      "in": [
        "q.app-kind",
        [
          "content-site",
          "portfolio"
        ]
      ]
    },
    "effects": [
      {
        "type": "modify",
